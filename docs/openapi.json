{
  "openapi": "3.1.1",
  "info": {
    "title": "Sendway",
    "description": "Send email, SMS and app push through one HTTP API. A send is accepted with 202 and delivered asynchronously; read the outcome from the message status or receive it as a Standard Webhooks event.",
    "version": "v1"
  },
  "paths": {
    "/messages/email": {
      "post": {
        "tags": [
          "Messages"
        ],
        "summary": "Accept an email for delivery",
        "operationId": "SendEmail",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Up to 255 characters. A repeat of the same request with the same key, within 24 hours, is answered with the original message instead of sending again; the same key with a different request is 422.",
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendEmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendMessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/messages/push": {
      "post": {
        "tags": [
          "Messages"
        ],
        "summary": "Accept an app push notification for delivery",
        "operationId": "SendPush",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Up to 255 characters. A repeat of the same request with the same key, within 24 hours, is answered with the original message instead of sending again; the same key with a different request is 422.",
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendPushRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendMessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/messages/sms": {
      "post": {
        "tags": [
          "Messages"
        ],
        "summary": "Accept an SMS for delivery",
        "operationId": "SendSms",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Up to 255 characters. A repeat of the same request with the same key, within 24 hours, is answered with the original message instead of sending again; the same key with a different request is 422.",
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendSmsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendMessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/messages/{id}": {
      "get": {
        "tags": [
          "Messages"
        ],
        "summary": "Read a message's status and, once final, its outcome",
        "operationId": "GetMessage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MessageStatusResponse": {
        "required": [
          "id",
          "channel",
          "recipient",
          "status",
          "error",
          "reason",
          "refusedRecipients",
          "attempts",
          "acceptedAt",
          "completedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "channel": {
            "type": "string"
          },
          "recipient": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Queued",
              "Sending",
              "Sent",
              "Failed"
            ],
            "type": "string"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          },
          "reason": {
            "enum": [
              "recipient_refused",
              "message_refused",
              "recipient_rate_limited",
              "expired",
              "attempts_exhausted"
            ],
            "type": [
              "null",
              "string"
            ]
          },
          "refusedRecipients": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/RefusedRecipient"
            }
          },
          "attempts": {
            "type": "integer",
            "format": "int32"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "enum": [
              "invalid_request",
              "invalid_recipient",
              "idempotency_key_reused",
              "channel_not_configured",
              "rate_limited",
              "destination_not_allowed",
              "daily_limit_reached",
              "unauthorized",
              "not_found",
              "internal_error"
            ],
            "type": "string",
            "description": "What went wrong, for code to branch on."
          }
        }
      },
      "RefusedRecipient": {
        "required": [
          "address",
          "error"
        ],
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "SendEmailRequest": {
        "required": [
          "to",
          "subject",
          "body"
        ],
        "type": "object",
        "properties": {
          "to": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "subject": {
            "type": [
              "null",
              "string"
            ]
          },
          "body": {
            "type": [
              "null",
              "string"
            ]
          },
          "cc": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "bcc": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "htmlBody": {
            "type": [
              "null",
              "string"
            ]
          },
          "expiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "SendMessageResponse": {
        "required": [
          "id",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "Queued",
              "Sending",
              "Sent",
              "Failed"
            ],
            "type": "string"
          }
        }
      },
      "SendPushRequest": {
        "required": [
          "deviceToken",
          "title",
          "body"
        ],
        "type": "object",
        "properties": {
          "deviceToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "body": {
            "type": [
              "null",
              "string"
            ]
          },
          "expiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "SendSmsRequest": {
        "required": [
          "to",
          "body"
        ],
        "type": "object",
        "properties": {
          "to": {
            "type": [
              "null",
              "string"
            ]
          },
          "body": {
            "type": [
              "null",
              "string"
            ]
          },
          "expiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "tenantKey": {
        "type": "apiKey",
        "description": "The calling service's tenant key.",
        "name": "X-Api-Key",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "tenantKey": [ ]
    }
  ],
  "tags": [
    {
      "name": "Messages"
    }
  ],
  "webhooks": {
    "messageOutcome": {
      "post": {
        "summary": "A message reached its final outcome (Sent or Failed)",
        "description": "Signed per Standard Webhooks (https://www.standardwebhooks.com/) with the endpoint's whsec_ secret. Delivery is at least once: deduplicate on webhook-id. Answer 2xx to acknowledge; 410 stops further events.",
        "operationId": "MessageOutcome",
        "parameters": [
          {
            "name": "webhook-id",
            "in": "header",
            "description": "The event's id; the same on every redelivery of the event.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "webhook-timestamp",
            "in": "header",
            "description": "Unix seconds when this delivery was signed.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "webhook-signature",
            "in": "header",
            "description": "v1,<base64 HMAC-SHA256 of \"{webhook-id}.{webhook-timestamp}.{body}\">",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "type",
                  "timestamp",
                  "data"
                ],
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "message.sent",
                      "message.failed"
                    ],
                    "type": "string"
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "data": {
                    "$ref": "#/components/schemas/MessageStatusResponse"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "2XX": {
            "description": "Received."
          },
          "410": {
            "description": "The receiver wants no more events."
          }
        }
      }
    }
  }
}