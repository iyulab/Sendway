<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sendway.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="FirebaseAdmin" Version="3.7.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.13" />
    <!-- Sqlite backs the test suite and the local try-out path (Sendway:DatabaseProvider=Sqlite);
         deployments use Npgsql — Sqlite over a network-mounted volume corrupts under EF Core's
         default WAL journal mode. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageReference Include="Microsoft.Graph" Version="6.8.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- MimeKit 4.18.1 resolves System.Security.Cryptography.Pkcs 10.0.0, which is inside the range of
         GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7. The running service takes this assembly from the shared
         framework (Microsoft.AspNetCore.App), so this reference is what restores and audits see; it raises
         the resolved version for every consumer of this project. TODO: remove once MimeKit depends on
         10.0.13 or later. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
