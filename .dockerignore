# The image is built from src/ only. Everything else stays out of the build context: it is not
# needed there, and local-only files next to the sources (environment files, local databases,
# key rings) must never travel with it.
.git
.github
.claude
.vs
**/bin
**/obj
tests
docs
claudedocs
dev-docs
.env*
*.md
**/appsettings.Development.json
**/*.db
**/*.db-shm
**/*.db-wal
**/dp-keys
clients
